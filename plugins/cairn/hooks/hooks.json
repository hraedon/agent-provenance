{
  "description": "Cairn digest-only provenance for local Codex lifecycle and tool activity.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cairn-codex-hook session-start",
            "commandWindows": "cairn-codex-hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cairn-codex-hook pre",
            "commandWindows": "cairn-codex-hook pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cairn-codex-hook post",
            "commandWindows": "cairn-codex-hook post",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cairn-codex-hook stop",
            "commandWindows": "cairn-codex-hook stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
